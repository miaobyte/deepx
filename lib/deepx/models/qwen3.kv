// Qwen3 前端表示 —— 对标 transformers.models.qwen3 的模块树（Qwen3MLP / Qwen3Attention /
// Qwen3DecoderLayer / Qwen3Model）。模块为 deepx/models/qwen3 包下的 rwfunc，逐层调用
// deepx/nn 模块与前端抽象算子 deepx·{op}；权重不内联，以 /model/<name>/ 全局变量按 pytorch
// state_dict 的点分名寻址（如 /model/Qwen3-0.6B/model.layers.0.self_attn.q_proj.weight）。
// 高层算子（rope/sdpa/repeat_kv）作为稳定前端算子面，后端由计算引擎兑现或编译器分解。
lib deepx/models/qwen3 {

	// Qwen3MLP：SwiGLU —— down( silu(gate(x)) * up(x) )。权重均为 [out,in] 二维浮点。
	rwfunc mlp(x:[+]float32|[+]float64, gate_w:[.,.]float32|[.,.]float64, up_w:[.,.]float32|[.,.]float64, down_w:[.,.]float32|[.,.]float64) -> (y:[+]float32|[+]float64) {
		deepx/nn·linear(x, gate_w) -> g
		deepx/nn·silu(g) -> ga
		deepx/nn·linear(x, up_w) -> u
		deepx·mul(ga, u) -> gu
		deepx/nn·linear(gu, down_w) -> y
	}

	// Qwen3Attention：GQA + 逐头 RMSNorm(q_norm/k_norm 作用于 head_dim) + RoPE + 因果 SDPA。
	// n_heads/n_kv_heads/head_dim 为结构常量；pos 为位置索引，theta 为 RoPE 底数，eps 为 norm epsilon。
	rwfunc attention(x:[+]float32|[+]float64, q_w:[.,.]float32|[.,.]float64, k_w:[.,.]float32|[.,.]float64, v_w:[.,.]float32|[.,.]float64, o_w:[.,.]float32|[.,.]float64,
	                 q_norm_w:[.]float32|[.]float64, k_norm_w:[.]float32|[.]float64,
	                 pos:[+]int32|[+]int64, n_heads:int64, n_kv_heads:int64, head_dim:int64,
	                 theta:float64, eps:float64) -> (y:[+]float32|[+]float64) {
		deepx/nn·linear(x, q_w) -> q0
		deepx/nn·linear(x, k_w) -> k0
		deepx/nn·linear(x, v_w) -> v
		deepx·rmsnorm(q0, q_norm_w, eps) -> q1
		deepx·rmsnorm(k0, k_norm_w, eps) -> k1
		deepx·rope(q1, pos, head_dim, theta) -> q
		deepx·rope(k1, pos, head_dim, theta) -> k
		deepx·sdpa(q, k, v, n_heads, n_kv_heads, head_dim) -> ctx
		deepx/nn·linear(ctx, o_w) -> y
	}

	// Qwen3DecoderLayer：pre-norm 残差 —— h=x+attn(ln1(x))；out=h+mlp(ln2(h))。
	rwfunc decoder_layer(x:[+]float32|[+]float64,
	                     in_ln_w:[.]float32|[.]float64, post_ln_w:[.]float32|[.]float64,
	                     q_w:[.,.]float32|[.,.]float64, k_w:[.,.]float32|[.,.]float64, v_w:[.,.]float32|[.,.]float64, o_w:[.,.]float32|[.,.]float64, q_norm_w:[.]float32|[.]float64, k_norm_w:[.]float32|[.]float64,
	                     gate_w:[.,.]float32|[.,.]float64, up_w:[.,.]float32|[.,.]float64, down_w:[.,.]float32|[.,.]float64,
	                     pos:[+]int32|[+]int64, n_heads:int64, n_kv_heads:int64, head_dim:int64,
	                     theta:float64, eps:float64) -> (y:[+]float32|[+]float64) {
		deepx·rmsnorm(x, in_ln_w, eps) -> xn
		deepx/models/qwen3·attention(xn, q_w, k_w, v_w, o_w, q_norm_w, k_norm_w, pos, n_heads, n_kv_heads, head_dim, theta, eps) -> a
		deepx·add(x, a) -> h
		deepx·rmsnorm(h, post_ln_w, eps) -> hn
		deepx/models/qwen3·mlp(hn, gate_w, up_w, down_w) -> m
		deepx·add(h, m) -> y
	}

	// Qwen3ForCausalLM.forward：embed → n_layers 层 decoder → final RMSNorm → lm_head。
	// 权重不作参数，按 root 全局根 + pytorch state_dict 点分名动态拼路径经 kv·get 取值
	// （root 如 "/model/Qwen3-0.6B"；layer i 前缀 "<root>/model.layers.<i>."）。
	// ids 为 token 序列 [seq]，pos 为位置 id [seq]（RoPE 用）；返回 logits [seq,vocab]。
	rwfunc model(root:[]char/utf32, ids:[+]int32|[+]int64, pos:[+]int32|[+]int64,
	             n_layers:int64, n_heads:int64, n_kv_heads:int64, head_dim:int64,
	             theta:float64, eps:float64) -> (logits:[+]float32|[+]float64) {
		kv·get(string·concat(root, "/model.embed_tokens.weight")) -> embed_w
		deepx/nn·embedding(ids, embed_w) -> h
		i = 0
		while (i < n_layers) {
			string·concat(root, "/model.layers.") -> pa
			string·concat(pa, string·formatint(i, 10)) -> pb
			string·concat(pb, ".") -> lp
			kv·get(string·concat(lp, "input_layernorm.weight")) -> in_ln_w
			kv·get(string·concat(lp, "post_attention_layernorm.weight")) -> post_ln_w
			kv·get(string·concat(lp, "self_attn.q_proj.weight")) -> q_w
			kv·get(string·concat(lp, "self_attn.k_proj.weight")) -> k_w
			kv·get(string·concat(lp, "self_attn.v_proj.weight")) -> v_w
			kv·get(string·concat(lp, "self_attn.o_proj.weight")) -> o_w
			kv·get(string·concat(lp, "self_attn.q_norm.weight")) -> q_norm_w
			kv·get(string·concat(lp, "self_attn.k_norm.weight")) -> k_norm_w
			kv·get(string·concat(lp, "mlp.gate_proj.weight")) -> gate_w
			kv·get(string·concat(lp, "mlp.up_proj.weight")) -> up_w
			kv·get(string·concat(lp, "mlp.down_proj.weight")) -> down_w
			deepx/models/qwen3·decoder_layer(h, in_ln_w, post_ln_w, q_w, k_w, v_w, o_w, q_norm_w, k_norm_w, gate_w, up_w, down_w, pos, n_heads, n_kv_heads, head_dim, theta, eps) -> h
			i = i + 1
		}
		kv·get(string·concat(root, "/model.norm.weight")) -> norm_w
		deepx·rmsnorm(h, norm_w, eps) -> hn
		kv·get(string·concat(root, "/lm_head.weight")) -> lm_head_w
		deepx/nn·linear(hn, lm_head_w) -> logits
	}

	// 贪心自回归 generate：首轮为 prefill（对整段 prompt 前向），其后每轮为 decode step。
	// 无 KV cache 的前端表示——每步对增长序列整段重算；KV cache 是后端/编译器的优化，不改本表示。
	// 每步取 logits 末位置的 argmax 作下一 token，追加回序列，共生成 max_new 个。
	rwfunc generate(root:[]char/utf32, prompt:[+]int64, max_new:int64,
	                n_layers:int64, n_heads:int64, n_kv_heads:int64, head_dim:int64,
	                theta:float64, eps:float64) -> (out:[+]int64) {
		out = prompt
		pos:[]int64 = [0]
		n0 = ndarray·numel(prompt)
		j = 1
		while (j < n0) {
			array·append(pos, j) -> pos
			array·compact(pos) -> pos
			j = j + 1
		}
		vocab_axis:[]int64 = [1]
		step = 0
		while (step < max_new) {
			deepx/models/qwen3·model(root, out, pos, n_layers, n_heads, n_kv_heads, head_dim, theta, eps) -> logits
			deepx·argmax(logits, vocab_axis, false) -> toks
			n = ndarray·numel(out)
			idx = n - 1
			xv·at(toks, idx) -> next
			array·append(out, next) -> out
			array·compact(out) -> out
			array·append(pos, n) -> pos
			array·compact(pos) -> pos
			step = step + 1
		}
	}
}
